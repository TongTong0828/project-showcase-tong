# OpenAI-compatible LLM provider.
# For DeepSeek, set OPENAI_BASE_URL to the provider's compatible endpoint and
# keep real keys only in your local .env or shell environment.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=deepseek-chat
SMALL_MODEL=deepseek-chat

# Optional OpenAI-compatible vision model used during ingest to summarize
# MinerU-extracted figures/tables before embedding. Leave unset to keep the
# default caption/context-only behavior.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Local config used by scripts and examples.
PAPER_RAG_CONFIG=config/local.yaml
